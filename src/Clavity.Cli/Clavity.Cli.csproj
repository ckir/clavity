<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Clavity.Ls\Clavity.Ls.csproj" />
    <ProjectReference Include="..\Clavity.Mcp\Clavity.Mcp.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.9" />
    <PackageReference Include="ModelContextProtocol" Version="1.4.0" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>clavity-ls</AssemblyName>
    <!-- Single-file / self-contained / RID props are passed on the CI `dotnet publish` command line
         (Task 3.3), NOT pinned here: in the csproj they would force win-x64 restore (breaking the
         documented Linux/macOS porting build) and copy the self-contained runtime on every local
         Debug build. Spike 0.3 proved the publish-time flags yield a non-extracting single-file exe. -->
  </PropertyGroup>

</Project>

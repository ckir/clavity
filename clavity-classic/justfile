# clavity-classic dev recipes. Run standalone, or via the root justfile's `classic::` module.
# Recipes MIRROR ci-classic.yml exactly (Format + Clippy + Test + Build). Do not add stricter gates.

default:
    @just --list

# Lint gate: format check + clippy with test-fakes (ci-classic "Format" + "Clippy" steps).
lint:
    cargo fmt --all --check
    cargo clippy --all-targets --features test-fakes -- -D warnings

# `&& pytest` is a just POST-DEPENDENCY: the cargo body runs first, then the `pytest` recipe below. Used
# instead of repeating the seven-file list here, so the recipe and CI cannot drift apart by editing one.
#
# ⚠ THE LINE DIRECTLY BELOW IS WHAT `just --list` PRINTS AS THIS RECIPE'S DESCRIPTION - not the block
# above it. Caught here for the second time: the first draft of this comment ended on the "instead of
# repeating the seven-file list" sentence, and `just --list` advertised that fragment as what `test` does.
# Keep a real one-line summary immediately above every recipe, and RUN `just --list` to check it.
#
# Rust tests + the 24 Python bridge tests (mirrors ci-classic's two Test steps).
test: && pytest
    cargo test --all --features test-fakes

# agy-mcp-bridge Python tests — 24 tests that NO recipe reached until 2026-09-05, and NO CI ran until the
# same day.
#
# NOW WIRED INTO `test:`, AND THE EARLIER VERSION OF THIS COMMENT SAID THE OPPOSITE. It said "NOT wired
# into `test:` ON PURPOSE", on the correct reasoning that line 2 forbids the local recipes being STRICTER
# than ci-classic.yml, which then ran cargo only. That premise is gone: ci-classic.yml now runs these same
# 24 tests as its own step, so the mirror rule does not merely permit wiring them in - it REQUIRES it.
# Leaving them out would make the LOCAL gate weaker than CI, which is exactly the failure shape ROADMAP
# section 36 records for the dotnet half (`just dotnet::test` greens over a smaller set than CI enforces).
#
# The comment is rewritten rather than deleted because the reasoning was right both times; only the fact
# it depended on changed. If ci-classic ever drops the Python step, this must go back.
#
# EXPLICIT FILE LIST, not a directory. `pytest` at the bridge root collects 26 tests, not 24 - the extra
# two are tests/test_integration.py. They MUTATE THE CURRENT WORKING DIRECTORY: target_directory is
# os.path.abspath("."), the bridge writes .agent/telemetry.db there, and one test creates and removes
# pytest_artifact.txt there. A routine test recipe must not write into whatever directory it was invoked
# from, so those two live in `pytest-integration` below.
#
# CORRECTION, recorded because an earlier version of this comment and its commit message said it: those
# tests do NOT spawn a live agy. Both set MOCK_AGENT_RESPONSE, so the agent is mocked. The reason to gate
# them is the working-directory mutation above, not a live peer. Reading the file corrected the claim.
#
# Belt AND braces: tests/test_integration.py now also self-skips via a module-level
# pytest.mark.skipif on CLAVITY_RUN_INTEGRATION_TESTS, so the file is safe even when someone runs bare
# `pytest`. The explicit list here is no longer the only thing standing between a routine run and a
# mutated working directory - it is the same explicit-list convention the Pester suites use.
#
# `uv run --frozen` resolves from uv.lock, so this works from a fresh clone. The bridge's .venv is
# gitignored, and MEASURED 2026-09-05 the system interpreter cannot run these at all:
# `ModuleNotFoundError: No module named 'mcp'`. uv is what makes the recipe reproducible rather than
# dependent on whatever happens to be installed.
#
# NOT QUITE HERMETIC, and the word was mine and wrong. Capstone R7 follow-up. `tests/test_secret_scrub.py:15`
# and `tests/test_mcp_wiring.py:19` both `import server`, and server.py runs `os.makedirs(".agent",
# exist_ok=True)` at MODULE LOAD - so this recipe creates a `.agent/` directory in its CWD.
#
# MEASURED, because the peer's version of this finding was directionally right and wrong in both
# specifics: it lands in `clavity-classic/` (not agy-mcp-bridge/, because `--project` leaves CWD here),
# and it is an EMPTY directory - no `server.log`, because `logging.basicConfig` is a no-op once pytest
# has installed root-logger handlers, so only the makedirs survives. It is gitignored at
# clavity-classic/.gitignore:6, so nothing reaches `git status`.
#
# Left as-is rather than "fixed": an empty ignored directory is not worth adding indirection to prevent,
# and moving CWD would relocate the side effect rather than remove it. Recorded so the next reader is not
# told this recipe touches nothing.
#
# agy-mcp-bridge Python tests (24) - also run by `test:` and by ci-classic.
pytest:
    uv run --project agy-mcp-bridge --frozen pytest \
        agy-mcp-bridge/test_agy_bus.py \
        agy-mcp-bridge/test_client.py \
        agy-mcp-bridge/test_isolation.py \
        agy-mcp-bridge/test_agy_tmux.py \
        agy-mcp-bridge/tests/test_hooked_commit.py \
        agy-mcp-bridge/tests/test_mcp_wiring.py \
        agy-mcp-bridge/tests/test_secret_scrub.py

# OPT-IN and MUTATING. Verified by reading, not inferred from the tool's name - and corrected four times,
# so the line numbers are cited to be checked:
#   server.py:65-71  ON IMPORT, unconditionally: creates `.agent/` and `.agent/server.log`. Spawning the
#                    server is enough; no tool call needed. This is the ONLY thing the first test does -
#                    it calls list_tools() and never reaches the delegation path.
#   server.py:194-210 SECOND TEST ONLY: init_db + log_start write `.agent/telemetry.db`, and
#                    create_worktree makes a REAL GIT WORKTREE - all BEFORE the MOCK_AGENT_RESPONSE
#                    check at :218, so the mock does not prevent them.
# The agent itself IS mocked, so no live peer runs. Everything lands in the process CWD.
#
# TWO THINGS THIS RECIPE MUST DO, and the first draft did NEITHER:
#   1. SET THE OPT-IN VAR. test_integration.py self-skips without it, so the recipe written to RUN these
#      tests silently SKIPPED them and reported success - MEASURED, `2 skipped`, exit 0. The guard was
#      added after the recipe and the recipe was never re-run.
#   2. RUN FROM THE BRIDGE DIRECTORY. The tests spawn `args=["server.py"]`, a RELATIVE path. MEASURED,
#      `uv run --project agy-mcp-bridge` keeps CWD at clavity-classic/, where server.py does not exist,
#      so the spawn would fail. `--directory` puts CWD where the tests assume it is - which is also where
#      the worktree and telemetry DB then land, instead of in the repo root.
#
# OPT-IN and MUTATING - creates a git worktree and a telemetry DB. Never call from a default path.
pytest-integration:
    CLAVITY_RUN_INTEGRATION_TESTS=1 uv run --directory agy-mcp-bridge --frozen pytest tests/test_integration.py

# Release build — no test-fakes, so the fake psmux never ships (ci-classic "Build (release)" step).
build:
    cargo build --release

# Auto-format (mutating).
fmt:
    cargo fmt --all

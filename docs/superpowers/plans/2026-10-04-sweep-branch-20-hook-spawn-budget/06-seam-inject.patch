     printf '%s\n' '{"hookSpecificOutput":{"hookEventName":"PreToolUse","additionalContext":"[AGY-DISCIPLINES] guard inactive: missing jq - no seam directive will auto-fire (disciplines AND anomaly-capture)"}}'
   fi
   exit 0
 fi
 
-skill=$(printf '%s' "$input" | jq -r '.tool_input.skill // ""' 2>/dev/null)
-cwd=$(printf '%s' "$input" | jq -r '.cwd // "."' 2>/dev/null)
+# ONE jq call yields both fields (two `$(printf | jq)` cost 6 processes, this costs 2). The pair is only trusted
+# when BOTH values are strings with no newline in them, which makes the split below exact; the closing `#` line
+# keeps `$(...)` from stripping a trailing newline when cwd is the empty string. Anything else - a non-string
+# field, a newline inside a value, a payload jq cannot parse - takes the original two-call form, so those
+# inputs behave exactly as before.
+_pair=$(jq -r '(.tool_input.skill // "") as $s | (.cwd // ".") as $c
+               | if ($s|type) == "string" and ($c|type) == "string" and (($s + $c) | (contains("\n") or contains("\r")) | not)
+                 then "=\($s)\n\($c)\n#" else "!" end' <<<"$input" 2>/dev/null)
+case "$_pair" in
+  =*)
+    # The Windows jq writes CRLF line ends. No value can hold a CR (guarded above), so dropping every CR is
+    # exact; `$(...)` strips only the final one.
+    _pair=${_pair//$'\r'/}
+    _rest=${_pair#=}; _rest=${_rest%$'\n#'}
+    skill=${_rest%%$'\n'*}
+    cwd=${_rest#*$'\n'}
+    ;;
+  *)
+    skill=$(jq -r '.tool_input.skill // ""' <<<"$input" 2>/dev/null)
+    cwd=$(jq -r '.cwd // "."' <<<"$input" 2>/dev/null)
+    ;;
+esac
 
